{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "PosWebApp": "Debug"
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 60,
    "RetryCount": 1
  },
  "Cache": {
    "CatalogSlidingExpirationMinutes": 5,
    "ImageAbsoluteExpirationHours": 1,
    "UseRedis": false,
    "RedisConnectionString": ""
  },
  "Auth": {
    "SessionTimeoutHours": 8,
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5
  }
}