{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "PosWebApp": "Information"
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "RetryCount": 3
  },
  "Cache": {
    "CatalogSlidingExpirationMinutes": 60,
    "ImageAbsoluteExpirationHours": 24,
    "UseRedis": false,
    "RedisConnectionString": ""
  },
  "Auth": {
    "SessionTimeoutHours": 8,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 30
  }
}