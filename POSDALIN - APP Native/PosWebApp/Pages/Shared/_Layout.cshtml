<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    @* Requirement 14.6 — viewport meta tag for proper mobile rendering *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PosWebApp</title>

    @* Requirement 14.1 — Bootstrap 5 from CDN (no npm/webpack) *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    @* Bootstrap Icons via CDN *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* Khmer Unicode font support — Req 20.2 *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Battambang:wght@400;700&family=Nokora:wght@100;300;400;700;900&display=swap" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PosWebApp.styles.css" asp-append-version="true" />

    @* ── Global print stylesheet — Requirements 26.12, 8.10 ────────────── *@
    @* Hides navigation, footer, and action buttons; sets 80-mm page size.  *@
    <style>
        @@media print {
            @@page {
                size: 80mm auto;
                margin: 4mm;
            }

            /* Hide navigation, footer, and interactive chrome */
            nav,
            .navbar,
            footer,
            .btn,
            .no-print,
            a[role="button"],
            .skip-nav {
                display: none !important;
            }

            /* Remove container padding so content fills 80-mm width */
            .container-fluid,
            .container {
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }

            /* Ensure cards print without excessive chrome */
            .card {
                border: 1px solid #dee2e6 !important;
                box-shadow: none !important;
                break-inside: avoid;
            }

            /* Keep tables readable */
            table {
                border-collapse: collapse;
            }

            a[href]::after {
                content: "" !important; /* suppress URL printing next to links */
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @* Requirement 20.8 — skip navigation link for keyboard users *@
    @* rel="skip-navigation" per task 27; Bootstrap .visually-hidden-focusable
       shows it only when focused via keyboard (Tab key). *@
    <a class="skip-nav visually-hidden-focusable" href="#main-content" rel="skip-navigation">
        Skip to main content
    </a>

    @* Requirement 20.10 — ARIA live region for cart badge (polite, so screen
       readers announce the update at the next opportunity without interruption).
       Updated by site.js / cart.js when the cart count changes. *@
    <div id="cart-badge-live"
         aria-live="polite"
         aria-atomic="true"
         class="visually-hidden"></div>

    @* Requirement 20.10 — ARIA live region for toast notifications.
       Bootstrap toasts have role="alert" or aria-live="assertive" themselves;
       this container ensures dynamically-appended toasts are also announced. *@
    <div id="toast-live-region"
         aria-live="polite"
         aria-atomic="false"
         class="visually-hidden"></div>

    @* Requirement 20.4 — ARIA landmark: nav rendered from shared partial *@
    @await Html.PartialAsync("_NavbarPartial")

    <div class="container-fluid px-3 px-md-4">
        @* Requirement 20.4 — ARIA landmark: <main> with id for skip-nav anchor *@
        <main id="main-content" role="main" class="pb-4 mt-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-2">
        <div class="container-fluid px-3 px-md-4">
            &copy; @DateTime.Now.Year - PosWebApp
        </div>
    </footer>

    @* Requirement 14.1 — Bootstrap 5 JS bundle from CDN *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    @* Requirement 7.1 — SignalR client library for real-time cart badge updates *@
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"
            crossorigin="anonymous"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @* cart.js loaded globally — provides window.addToCart, badge and summary updates on all pages *@
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @* Req 10.9 — search autocomplete (loaded on all pages so navbar search works everywhere) *@
    <script src="~/js/search.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
