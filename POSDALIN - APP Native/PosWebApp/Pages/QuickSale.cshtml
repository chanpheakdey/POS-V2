@page
@model PosWebApp.Pages.QuickSaleModel
@{
    ViewData["Title"] = "Quick Sale";
    var khrRate = Model.KhrExchangeRate;
}

@* Quick Sale Mode - Requirements 33.1 through 33.11 *@

@* ── Hidden anti-forgery token used by quicksale.js AJAX calls *@
@Html.AntiForgeryToken()

@* ── Page header *@
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0 fw-semibold">
        <i class="bi bi-lightning-fill text-warning me-2" aria-hidden="true"></i>Quick Sale
    </h1>
    @* Req 33.11 - Exit button navigates back to home *@
    <a href="/"
       id="qs-exit-btn"
       class="btn btn-outline-secondary"
       aria-label="Exit Quick Sale and return to home">
        <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Exit
    </a>
</div>

@* ── Status / scan feedback *@
<div id="qs-alert" class="alert d-none" role="alert" aria-live="polite"></div>

@* ═══════════════════════════════════════════════════════════════════════════
   BARCODE INPUT — Req 33.3: auto-submits on Enter key
   ═══════════════════════════════════════════════════════════════════════ *@
<div class="card mb-3 border-primary">
    <div class="card-body py-3">
        <label for="qs-barcode" class="form-label fw-semibold mb-1">
            <i class="bi bi-upc-scan me-1" aria-hidden="true"></i>
            Scan / Enter Barcode
        </label>
        <div class="input-group input-group-lg">
            <span class="input-group-text bg-primary text-white">
                <i class="bi bi-upc" aria-hidden="true"></i>
            </span>
            @* Req 33.3 — barcode field auto-submits when Enter is pressed *@
            <input type="text"
                   id="qs-barcode"
                   class="form-control form-control-lg"
                   placeholder="Scan barcode or type item code…"
                   autocomplete="off"
                   autocorrect="off"
                   spellcheck="false"
                   aria-label="Barcode input"
                   autofocus />
            <button type="button"
                    id="qs-scan-btn"
                    class="btn btn-primary"
                    aria-label="Add item to cart">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add
            </button>
        </div>
        <div class="form-text">Barcode scanner or keyboard entry. Press <kbd>Enter</kbd> to add to cart.</div>
    </div>
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   CART ITEMS — Req 33.5: running total in the middle
   ═══════════════════════════════════════════════════════════════════════ *@
<div class="card mb-3" id="qs-cart-card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h2 class="h6 mb-0">
            <i class="bi bi-cart3 me-1" aria-hidden="true"></i>
            Cart Items
            <span class="badge bg-secondary ms-2" id="qs-item-count">@Model.CartItems.Count</span>
        </h2>
        <span class="text-muted small">
            <span id="qs-item-count-units">@Model.CartItems.Sum(i => i.Quantity)</span> units
        </span>
    </div>

    @if (!Model.CartItems.Any())
    {
        <div class="card-body text-center text-muted py-4" id="qs-empty-state">
            <i class="bi bi-inbox fs-3 d-block mb-2" aria-hidden="true"></i>
            No items yet — scan a barcode to begin.
        </div>
        <div class="card-body p-0 d-none" id="qs-table-wrapper">
            <table class="table table-sm table-hover mb-0 align-middle" aria-label="Quick sale cart">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Item</th>
                        <th scope="col" class="text-center">Qty</th>
                        <th scope="col" class="text-end">Unit</th>
                        <th scope="col" class="text-end">Subtotal</th>
                        <th scope="col" class="text-center">Remove</th>
                    </tr>
                </thead>
                <tbody id="qs-cart-tbody"></tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body p-0 d-none" id="qs-empty-state">
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-3 d-block mb-2" aria-hidden="true"></i>
                No items yet — scan a barcode to begin.
            </div>
        </div>
        <div class="card-body p-0" id="qs-table-wrapper">
            <table class="table table-sm table-hover mb-0 align-middle" aria-label="Quick sale cart">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Item</th>
                        <th scope="col" class="text-center">Qty</th>
                        <th scope="col" class="text-end">Unit</th>
                        <th scope="col" class="text-end">Subtotal</th>
                        <th scope="col" class="text-center">Remove</th>
                    </tr>
                </thead>
                <tbody id="qs-cart-tbody">
                    @foreach (var item in Model.CartItems)
                    {
                        <tr data-item-id="@item.ItemId">
                            <td class="small text-muted">@item.ItemCode</td>
                            <td class="fw-semibold small">@item.ItemName</td>
                            <td class="text-center small">@item.Quantity</td>
                            <td class="text-end small">@item.UnitPriceUsd</td>
                            <td class="text-end small fw-semibold">@item.LineTotalUsd</td>
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger qs-remove-btn"
                                        data-item-id="@item.ItemId"
                                        aria-label="Remove @item.ItemName from cart">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ═══════════════════════════════════════════════════════════════════════════
   NUMBER PAD + RUNNING TOTAL — Req 33.5, 33.6
   ═══════════════════════════════════════════════════════════════════════ *@
<div class="row g-3 mb-3">

    @* Number pad — Req 33.6 *@
    <div class="col-sm-6 col-md-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h6 mb-0">
                    <i class="bi bi-123 me-1" aria-hidden="true"></i>Quantity
                </h2>
            </div>
            <div class="card-body">
                <div class="input-group mb-2">
                    <input type="text"
                           id="qs-qty-display"
                           class="form-control text-center fw-bold fs-5"
                           value="1"
                           readonly
                           aria-label="Current quantity"
                           aria-live="polite" />
                </div>

                @* 3 x 3 digit grid *@
                <div class="d-grid gap-1" style="grid-template-columns: repeat(3, 1fr); display: grid;">
                    @foreach (var d in new[] { 7, 8, 9, 4, 5, 6, 1, 2, 3 })
                    {
                        <button type="button"
                                class="btn btn-outline-secondary qs-numpad-btn"
                                data-digit="@d"
                                aria-label="@d">
                            @d
                        </button>
                    }
                </div>

                @* Bottom row: 0 and backspace *@
                <div class="d-grid gap-1 mt-1" style="grid-template-columns: 2fr 1fr; display: grid;">
                    <button type="button"
                            class="btn btn-outline-secondary qs-numpad-btn"
                            data-digit="0"
                            aria-label="0">
                        0
                    </button>
                    <button type="button"
                            class="btn btn-outline-warning"
                            id="qs-numpad-backspace"
                            aria-label="Backspace">
                        <i class="bi bi-backspace" aria-hidden="true"></i>
                    </button>
                </div>

                @* Clear quantity *@
                <button type="button"
                        class="btn btn-outline-secondary w-100 mt-1"
                        id="qs-numpad-clear"
                        aria-label="Clear quantity">
                    Clear
                </button>
            </div>
        </div>
    </div>

    @* Running total — Req 33.5 *@
    <div class="col-sm-6 col-md-7">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h6 mb-0">
                    <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>Running Total
                </h2>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                <div class="display-5 fw-bold text-success" id="qs-total-usd" aria-live="polite">
                    @Model.TotalUsdText
                </div>
                <div class="fs-5 text-muted" id="qs-total-khr">@Model.TotalKhrText</div>
            </div>

            @* Checkout and checkout actions *@
            <div class="card-footer d-flex gap-2">
                @* Req 33.7/33.8 — Enter/Checkout navigates to /Checkout with Cash pre-selected *@
                <a href="/Checkout?paymentMethod=Cash"
                   id="qs-checkout-btn"
                   class="btn btn-success flex-grow-1"
                   aria-label="Proceed to checkout with Cash payment">
                    <i class="bi bi-credit-card me-1" aria-hidden="true"></i>
                    Checkout
                    <kbd class="ms-1 opacity-75">Enter</kbd>
                </a>
            </div>
        </div>
    </div>

</div>

@* ── Print receipt note — Req 33.10 *@
<p class="text-muted small text-center">
    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
    Receipt will be printed automatically after payment is recorded.
</p>

@section Scripts {
    <script>
        window.__quickSale = {
            scanUrl:     '@Html.Raw(Url.Page("/QuickSale", "Scan"))',
            removeUrl:   '@Html.Raw(Url.Page("/QuickSale", "Remove"))',
            checkoutUrl: '/Checkout',
            khrRate:     @khrRate.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
    </script>
    <script src="~/js/quicksale.js" asp-append-version="true"></script>
}
