@page "/Items/{categoryId:int}/{groupId:int?}"
@model ItemsModel
@using PosWebApp.Models.ViewModels
@{
    ViewData["Title"] = "Items";
}

@* ── Breadcrumb (Requirement 4.6 — back navigation) ─────────────────────── *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-page="/Index">
                <i class="bi bi-house-door me-1" aria-hidden="true"></i>Home
            </a>
        </li>
        @if (Model.GroupId.HasValue)
        {
            <li class="breadcrumb-item">
                <a asp-page="/Groups" asp-route-categoryId="@Model.CategoryId">Groups</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">Items</li>
    </ol>
</nav>

@* ── Error banner ─────────────────────────────────────────────────────────── *@
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ── Empty state ──────────────────────────────────────────────────────────── *@
@if (!Model.Items.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-box-seam fs-1 text-muted" aria-hidden="true"></i>
        <p class="mt-2 text-muted">No items found.</p>
        @if (Model.GroupId.HasValue)
        {
            <a asp-page="/Groups" asp-route-categoryId="@Model.CategoryId" class="btn btn-secondary mt-2">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Groups
            </a>
        }
        else
        {
            <a asp-page="/Index" class="btn btn-secondary mt-2">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Categories
            </a>
        }
    </div>
}
else
{
    @* ── Item grid — Requirements 4.7, 4.8, 4.10 ────────────────────────── *@
    @* Same responsive column classes as the Groups and Index pages. *@
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-3"
         id="item-grid" role="list" aria-label="Product items">

        @foreach (var item in Model.Items)
        {
            <div class="col" role="listitem">
                @* Requirement 5.1 — clicking an item card opens the item detail modal.
                   A <button> wrapper prevents the _ItemCardPartial anchor (Href="#") from
                   acting as a navigation link.  The data-item-id attribute allows JS
                   (showItemDetail) to pick up the item ID from any child click. *@
                <button type="button"
                        class="btn p-0 w-100 border-0 text-start item-card-trigger"
                        data-item-id="@item.Id"
                        onclick="showItemDetail(@item.Id)"
                        aria-label="View details for @item.Name">
                    <partial name="_ItemCardPartial" model="item" />
                </button>
            </div>
        }

    </div>
}

@* ── Item detail modal placeholder (populated via AJAX by showItemDetail) ── *@
@* The _ItemDetailModal partial provides the Bootstrap modal markup and the
   showItemDetail(itemId) JavaScript function that fetches /Items/Detail/{id}
   and injects the response into the modal body. *@
@if (System.IO.File.Exists(System.IO.Path.Combine(
    System.AppContext.BaseDirectory, "Pages", "Shared", "_ItemDetailModal.cshtml")))
{
    @await Html.PartialAsync("_ItemDetailModal")
}
else
{
    @* Minimal modal scaffold so the page works even before the modal partial is built. *@
    <div class="modal fade" id="itemDetailModal" tabindex="-1"
         aria-labelledby="itemDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="itemDetailModalLabel">Item Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="itemDetailModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading…</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Bootstrap toast container — Requirement 6.11, 20.10 (ARIA live for notifications) *@
<div class="toast-container position-fixed bottom-0 end-0 p-3"
     id="toast-container"
     aria-live="polite"
     aria-atomic="true"></div>

@section Scripts {
    <script>
        /**
         * Opens the item detail modal and fetches content from
         * /Items/Detail/{itemId} (AJAX handler on Items.cshtml.cs).
         * Falls back to a warning if the route is not yet implemented.
         *
         * Requirement 5.1 — display Bootstrap modal with item details.
         * Requirement 20.12 — Bootstrap 5 handles focus trap and Escape key.
         * Requirement 20.10 — modal title updated so screen readers announce new item.
         */
        function showItemDetail(itemId) {
            var modal = document.getElementById('itemDetailModal');
            if (!modal) {
                console.warn('itemDetailModal element not found for itemId=' + itemId);
                return;
            }

            var body = document.getElementById('itemDetailModalBody');
            var titleEl = document.getElementById('itemDetailModalLabel');
            if (body) {
                // Show spinner while fetching
                body.innerHTML = '<div class="text-center py-4" role="status">' +
                    '<div class="spinner-border text-primary" aria-hidden="true"></div>' +
                    '<p class="visually-hidden">Loading item details\u2026</p></div>';
            }
            if (titleEl) {
                titleEl.textContent = 'Loading\u2026';
            }

            // Show the modal immediately (Bootstrap 5 API)
            var bsModal = bootstrap.Modal.getOrCreateInstance(modal);
            bsModal.show();

            // Fetch item detail partial from server
            fetch('/Items/Detail/' + itemId, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (resp) {
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                return resp.text();
            })
            .then(function (html) {
                if (body) {
                    body.innerHTML = html;
                    // Wire qty increment buttons — scripts inside innerHTML are not executed
                    // by the browser, so we bind them here after injection.
                    wireQtyButtons(body);
                    // Update the modal title with the item name for screen readers (Req 20.10)
                    var itemNameEl = body.querySelector('h2.fw-bold, h2.h5');
                    if (itemNameEl && titleEl) {
                        titleEl.textContent = itemNameEl.textContent.trim();
                    }
                }
            })
            .catch(function (err) {
                console.error('Failed to load item detail', err);
                if (body) {
                    body.innerHTML = '<div class="alert alert-danger m-3" role="alert">Unable to load item details. Please try again.</div>';
                }
                if (titleEl) {
                    titleEl.textContent = 'Item Details';
                }
            });
        }
        /**
         * Wires the +1/+5/+10/+50 qty increment buttons inside a container,
         * keeps the live total display updated, and handles manual tier locking
         * via clickable rows in the price tier table.
         * Must be called after AJAX injection because innerHTML does not execute scripts.
         */
        function wireQtyButtons(container) {
            var input   = container.querySelector('#itemDetailQty');
            var feeInput = container.querySelector('#itemDetailFee');
            var feeClear = container.querySelector('#itemDetailFeeClear');
            if (!input) return;

            var section = container.querySelector('#itemDetailQtySection');
            var tiers = [];
            try { tiers = JSON.parse((section && section.dataset.tiers) || '[]'); } catch (e) {}

            // null = auto (pick tier by qty); number = locked via tier row click
            var lockedPrice = null;

            // ── tier row selection ───────────────────────────────────────────
            var tierRows = container.querySelectorAll('.tier-row');
            tierRows.forEach(function (row) {
                function selectRow() {
                    var alreadySelected = row.classList.contains('table-warning');
                    tierRows.forEach(function (r) {
                        r.classList.remove('table-warning');
                        r.querySelector('.tier-check').textContent = '';
                        r.setAttribute('aria-pressed', 'false');
                    });
                    if (alreadySelected) {
                        lockedPrice = null;
                        if (section) section.dataset.lockedTierId = '';
                    } else {
                        row.classList.add('table-warning');
                        row.querySelector('.tier-check').textContent = '✓';
                        row.setAttribute('aria-pressed', 'true');
                        lockedPrice = parseFloat(row.dataset.tierPrice) || null;
                        if (section) section.dataset.lockedTierId = row.dataset.tierId || '';
                        // Fill fee box with selected tier price so user can see/edit it
                        if (feeInput) feeInput.value = lockedPrice !== null ? lockedPrice.toFixed(2) : '';
                    }
                    updateTotal();
                }
                row.addEventListener('click', selectRow);
                row.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectRow(); }
                });
            });

            // ── price resolution ─────────────────────────────────────────────
            // Priority: fee override > locked tier > auto tier by qty
            function effectivePrice(qty) {
                if (feeInput) {
                    var feeVal = parseFloat(feeInput.value);
                    if (!isNaN(feeVal) && feeVal > 0) return feeVal;
                }
                if (lockedPrice !== null) return lockedPrice;
                var price = 0;
                for (var i = 0; i < tiers.length; i++) {
                    var t = tiers[i];
                    if (qty >= t.FromQty && (t.ToQty === 0 || qty <= t.ToQty)) { price = t.Price; break; }
                }
                if (price === 0 && tiers.length > 0) price = tiers[tiers.length - 1].Price;
                return price;
            }

            // ── total display ────────────────────────────────────────────────
            function updateTotal() {
                var qty   = parseInt(input.value, 10) || 1;
                var price = effectivePrice(qty);
                var total = qty * price;
                var feeOverride = feeInput && parseFloat(feeInput.value) > 0;
                var locked = feeOverride || lockedPrice !== null;
                var el = document.getElementById('itemDetailTotalValue');
                if (el) {
                    el.textContent = total > 0
                        ? '$' + total.toFixed(2) + ' (' + qty + ' \u00d7 $' + price.toFixed(2) + (locked ? ' \uD83D\uDD12' : '') + ')'
                        : '\u2014';
                }
            }

            // ── qty buttons ──────────────────────────────────────────────────
            container.querySelectorAll('.qty-increment').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var current = parseInt(input.value, 10) || 0;
                    var delta   = parseInt(btn.dataset.increment, 10) || 0;
                    input.value = Math.max(1, current + delta);
                    updateTotal();
                });
            });

            // ── fee input wiring ─────────────────────────────────────────────
            if (feeInput) {
                feeInput.addEventListener('input', function () {
                    // Clear tier row highlight when fee is manually typed
                    if (feeInput.value !== '') {
                        tierRows.forEach(function (r) {
                            r.classList.remove('table-warning');
                            r.querySelector('.tier-check').textContent = '';
                            r.setAttribute('aria-pressed', 'false');
                        });
                        lockedPrice = null;
                        if (section) section.dataset.lockedTierId = '';
                    }
                    updateTotal();
                });
            }
            if (feeClear) {
                feeClear.addEventListener('click', function () {
                    if (feeInput) feeInput.value = '';
                    updateTotal();
                });
            }

            // ── add-to-cart button ───────────────────────────────────────────
            var addBtn = container.querySelector('.btn-add-to-cart-modal');
            if (addBtn) {
                addBtn.addEventListener('click', function () { addToCartFromModal(); });
            }

            input.addEventListener('input', updateTotal);
            updateTotal();
        }

        function addToCartFromModal() {
            var btn      = document.getElementById('itemDetailAddBtn');
            var qtyInput = document.getElementById('itemDetailQty');
            var feeInput = document.getElementById('itemDetailFee');
            if (!btn || !qtyInput) return;

            var itemId   = parseInt(btn.dataset.itemId, 10);
            var itemCode = btn.dataset.itemCode  || '';
            var itemName = btn.dataset.itemName  || '';
            var imageUrl = btn.dataset.itemImage || '';
            var qty      = parseInt(qtyInput.value, 10) || 1;
            // Custom unit price override (0 = not set, let server use tier)
            var feeOverride = feeInput ? parseFloat(feeInput.value) : NaN;
            var unitPrice = (!isNaN(feeOverride) && feeOverride > 0) ? feeOverride : 0;

            function closeModal() {
                var modalEl = document.getElementById('itemDetailModal');
                if (modalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                }
            }

            if (typeof window.addToCart === 'function') {
                window.addToCart(itemId, itemCode, itemName, imageUrl, qty, unitPrice)
                    .then(function (data) { if (data && data.success) closeModal(); });
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = new URLSearchParams({
                '__RequestVerificationToken': token ? token.value : '',
                'AddInput.ItemId':        String(itemId),
                'AddInput.ItemCode':      itemCode,
                'AddInput.ItemName':      itemName,
                'AddInput.ImageUrl':      imageUrl,
                'AddInput.Quantity':      String(qty),
                'AddInput.UnitPriceOverride': unitPrice > 0 ? String(unitPrice) : '',
            });
            fetch('/Cart?handler=Add', {
                method:  'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    body.toString(),
            })
            .then(function (resp) {
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                return resp.json();
            })
            .then(function (data) {
                if (data && data.success) {
                    if (typeof window.updateCartSummary === 'function') window.updateCartSummary(data.badgeCount, data.totalUsd);
                    closeModal();
                } else {
                    showCartToast((data && data.error) || 'Could not add item.', 'danger');
                }
            })
            .catch(function (err) { console.error('addToCartFromModal failed', err); });
        }

        /**
         * Shows a Bootstrap success toast after adding to cart.
         * Delegates to showAddToCartToast() from cart.js when available.
         */
        function showCartToast(itemName, qty) {
            if (typeof showAddToCartToast === 'function') {
                showAddToCartToast(itemName, qty);
                return;
            }
            var c = document.getElementById('toast-container');
            if (!c) {
                c = document.createElement('div');
                c.id = 'toast-container';
                c.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                c.setAttribute('aria-live', 'polite');
                c.setAttribute('aria-atomic', 'true');
                document.body.appendChild(c);
            }
            var id = 'toast-' + Date.now();
            c.insertAdjacentHTML('beforeend',
                '<div id="' + id + '" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">' +
                '<div class="d-flex"><div class="toast-body">' +
                '<i class="bi bi-cart-check-fill me-1"></i>' +
                '<strong>' + qty + ' \u00d7 ' + itemName + '</strong> added to cart.' +
                '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div></div>');
            var el = document.getElementById(id);
            if (el && typeof bootstrap !== 'undefined') {
                var t = new bootstrap.Toast(el, { delay: 3000 });
                t.show();
                el.addEventListener('hidden.bs.toast', function () { el.remove(); });
            }
        }
    </script>
}
