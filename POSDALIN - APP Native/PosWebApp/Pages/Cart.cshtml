@page
@model PosWebApp.Pages.CartModel
@{
    ViewData["Title"] = "Cart";
    var khrRate = Model.KhrExchangeRate;
    bool isManagerOrAdmin = User.IsInRole("Manager") || User.IsInRole("Admin");
}

<h1 class="h3 mb-4">
    <i class="bi bi-cart3 me-2" aria-hidden="true"></i>Cart
</h1>

@* Requirement 17.10 — "Cart is empty" state *@
@if (!Model.ViewModel.HasItems)
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
        Your cart is empty. Browse <a asp-page="/Index" class="alert-link">categories</a> to add items.
    </div>
}
else
{
    @* Requirement 17.2, 17.3, 17.11 — cart item table using _CartItemPartial *@
    <div class="table-responsive">
        <table class="table table-hover align-middle" aria-label="Cart items">
            <thead class="table-light">
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Item</th>
                    <th scope="col" class="text-end">Unit Price</th>
                    <th scope="col" class="text-center">Qty</th>
                    <th scope="col" class="text-end">Line Total</th>
                    <th scope="col" class="text-center">Remove</th>
                    @* Requirement 28.5, 28.6 — discount column, Manager/Admin only *@
                    @if (isManagerOrAdmin)
                    {
                        <th scope="col" class="text-center">Discount</th>
                    }
                </tr>
            </thead>
            <tbody id="cart-table-body">
                @* Requirement 17.11 — render each row via _CartItemPartial *@
                @foreach (var item in Model.ViewModel.Items)
                {
                    await Html.PartialAsync("_CartItemPartial", item);
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                @* Requirement 17.7 — grand total in USD and KHR *@
                <tr>
                    <td colspan="@(isManagerOrAdmin ? 5 : 4)" class="text-end">Grand Total</td>
                    <td class="text-end" id="cart-grand-total">
                        @Model.ViewModel.TotalUsdText<br />
                        <small class="text-muted fw-normal">@Model.ViewModel.TotalKhrText</small>
                    </td>
                    <td></td>
                    @if (isManagerOrAdmin)
                    {
                        <td></td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>

    @* Requirement 17.5 — clear and checkout actions *@
    <div class="d-flex justify-content-between mt-3">
        <form method="post" asp-page-handler="Clear">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-outline-secondary"
                    onclick="return confirm('Clear the entire cart?')">
                <i class="bi bi-trash me-1" aria-hidden="true"></i>Clear Cart
            </button>
        </form>

        @* Requirement 17.8 — checkout button *@
        <a asp-page="/Checkout" class="btn btn-success">
            <i class="bi bi-credit-card me-1" aria-hidden="true"></i>Checkout
        </a>
    </div>

    @* ── Requirements 28.1–28.9: Discount section (Manager/Admin only) ─────── *@
    @if (isManagerOrAdmin)
    {
        <div class="card mt-4 border-primary" id="discount-section">
            <div class="card-header bg-primary bg-opacity-10">
                <h2 class="h6 mb-0 text-primary-emphasis">
                    <i class="bi bi-percent me-1" aria-hidden="true"></i>
                    Apply Discount
                    <span class="badge bg-primary ms-2 small">Manager / Admin</span>
                </h2>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Select an item and apply a percentage discount. Discounts over 20% require
                    an authorisation PIN from a Manager or Admin.
                </p>

                <div id="discount-alert" class="alert d-none" role="alert" aria-live="polite"></div>

                <div class="row g-3 align-items-end">
                    @* Item selector *@
                    <div class="col-sm-4">
                        <label for="discount-item-select" class="form-label fw-semibold">Item</label>
                        <select id="discount-item-select" class="form-select" aria-label="Select item to discount">
                            <option value="">— Select item —</option>
                            @foreach (var item in Model.ViewModel.Items)
                            {
                                <option value="@item.ItemId">@item.ItemCode – @item.ItemName</option>
                            }
                        </select>
                    </div>

                    @* Discount type *@
                    <div class="col-sm-3">
                        <label for="discount-type-select" class="form-label fw-semibold">Type</label>
                        <select id="discount-type-select" class="form-select" aria-label="Discount type">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="Fixed">Fixed (USD)</option>
                        </select>
                    </div>

                    @* Discount amount *@
                    <div class="col-sm-3">
                        <label for="discount-amount-input" class="form-label fw-semibold">
                            Amount <span id="discount-unit-label" class="text-muted">(0–100%)</span>
                        </label>
                        <input type="number"
                               id="discount-amount-input"
                               class="form-control"
                               min="0"
                               max="100"
                               step="0.5"
                               value="0"
                               aria-label="Discount amount" />
                    </div>

                    @* Apply button *@
                    <div class="col-sm-2">
                        <button type="button"
                                id="apply-discount-btn"
                                class="btn btn-primary w-100">
                            <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Authorisation modal for discounts > 20% (Requirement 28.7) ──────── *@
        <div class="modal fade"
             id="discountAuthModal"
             tabindex="-1"
             aria-labelledby="discountAuthModalLabel"
             aria-modal="true"
             role="dialog">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning bg-opacity-10">
                        <h5 class="modal-title" id="discountAuthModalLabel">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
                            Authorisation Required
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">
                            A discount over 20% requires a Manager or Admin to confirm with their UserID.
                        </p>
                        <label for="auth-user-id-input" class="form-label fw-semibold">
                            Authorising UserID
                        </label>
                        <input type="number"
                               id="auth-user-id-input"
                               class="form-control"
                               min="1"
                               placeholder="Enter UserID…"
                               aria-label="Authorising UserID" />
                        <div id="auth-modal-error" class="text-danger small mt-1 d-none"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning" id="confirm-auth-btn">
                            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Confirm
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* Bootstrap toast container (Requirement 6.11) *@
<div class="toast-container position-fixed bottom-0 end-0 p-3"
     aria-live="polite"
     aria-atomic="true">
    <div id="cart-toast"
         class="toast align-items-center text-bg-success border-0"
         role="alert">
        <div class="d-flex">
            <div class="toast-body" id="cart-toast-message">Item added to cart.</div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    @* Expose KHR rate, anti-forgery token and manager flag for cart.js AJAX calls *@
    <script>
        window.__khrRate = @khrRate.ToString(System.Globalization.CultureInfo.InvariantCulture);
        window.__isManagerOrAdmin = @(isManagerOrAdmin ? "true" : "false");
    </script>
    @* Requirement 17.12 — AJAX quantity updates via cart.js *@
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @* Requirement 28 — Discount logic *@
    @if (isManagerOrAdmin)
    {
        <script src="~/js/discount.js" asp-append-version="true"></script>
    }
}
