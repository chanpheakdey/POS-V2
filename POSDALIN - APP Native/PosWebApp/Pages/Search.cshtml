@page
@model SearchModel
@using PosWebApp.Models.ViewModels

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Q)
        ? "Search"
        : $"Search: {Model.Q}";
}

@* ── Breadcrumb ───────────────────────────────────────────────────────────── *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-page="/Index">
                <i class="bi bi-house-door me-1" aria-hidden="true"></i>Home
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Search</li>
    </ol>
</nav>

@* ── Page header ──────────────────────────────────────────────────────────── *@
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0 fw-semibold">
        <i class="bi bi-search me-2 text-primary" aria-hidden="true"></i>
        Search Results
        @if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            <span class="text-muted fw-normal fs-6 ms-2">for "<em>@Model.Q</em>"</span>
        }
    </h1>
    @* Req 10.6 — clear search returns to home *@
    <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Clear Search
    </a>
</div>

@* ── Error banner ─────────────────────────────────────────────────────────── *@
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
        @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ── Validation message when query is too short ───────────────────────────── *@
@if (Model.ShowMinLengthWarning)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
        Please enter at least 2 characters to search.
    </div>
}

@* ── Results ──────────────────────────────────────────────────────────────── *@
@if (!string.IsNullOrWhiteSpace(Model.Q) && !Model.ShowMinLengthWarning)
{
    @* Req 10.5 — "No items found" when results are empty *@
    @if (!Model.Results.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
            <p class="text-muted mb-3">No items found for "<strong>@Model.Q</strong>".</p>
            <a asp-page="/Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Categories
            </a>
        </div>
    }
    else
    {
        <p class="text-muted small mb-3">
            Showing <strong>@Model.Results.Count</strong> result@(Model.Results.Count == 1 ? "" : "s")
        </p>

        @* Req 10.4 — same responsive grid as category/item browsing *@
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-3"
             id="search-results-grid" role="list" aria-label="Search results">

            @foreach (var item in Model.Results)
            {
                <div class="col" role="listitem">
                    <button type="button"
                            class="btn p-0 w-100 border-0 text-start item-card-trigger"
                            data-item-id="@item.Id"
                            onclick="showItemDetail(@item.Id)"
                            aria-label="View details for @item.Name">
                        <partial name="_ItemCardPartial" model="item" />
                    </button>
                </div>
            }

        </div>
    }
}

@* ── Item detail modal placeholder ────────────────────────────────────────── *@
<div class="modal fade" id="itemDetailModal" tabindex="-1"
     aria-labelledby="itemDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemDetailModalLabel">Item Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="itemDetailModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Bootstrap toast container — Requirement 6.11, 20.10 (ARIA live for notifications) *@
<div class="toast-container position-fixed bottom-0 end-0 p-3"
     id="toast-container"
     aria-live="polite"
     aria-atomic="true"></div>

@section Scripts {
    <script>
        /**
         * Opens the item detail modal for a search result item.
         * Reuses the same AJAX pattern as Items.cshtml (Requirement 5.1).
         * Requirement 20.12 — Bootstrap 5 handles focus trap and Escape key.
         * Requirement 20.10 — modal title updated so screen readers announce the item.
         */
        function showItemDetail(itemId) {
            var modal = document.getElementById('itemDetailModal');
            if (!modal) return;

            var body = document.getElementById('itemDetailModalBody');
            var titleEl = document.getElementById('itemDetailModalLabel');
            if (body) {
                body.innerHTML = '<div class="text-center py-4" role="status">' +
                    '<div class="spinner-border text-primary" aria-hidden="true"></div>' +
                    '<p class="visually-hidden">Loading item details\u2026</p></div>';
            }
            if (titleEl) {
                titleEl.textContent = 'Loading\u2026';
            }

            var bsModal = bootstrap.Modal.getOrCreateInstance(modal);
            bsModal.show();

            fetch('/Search?handler=Detail&itemId=' + itemId, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (resp) {
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                return resp.text();
            })
            .then(function (html) {
                if (body) {
                    body.innerHTML = html;
                    // Update the modal title for screen readers (Req 20.10)
                    var itemNameEl = body.querySelector('h2.fw-bold, h2.h5');
                    if (itemNameEl && titleEl) {
                        titleEl.textContent = itemNameEl.textContent.trim();
                    }
                }
            })
            .catch(function (err) {
                console.error('Failed to load item detail', err);
                if (body) {
                    body.innerHTML = '<div class="alert alert-danger m-3" role="alert">Unable to load item details. Please try again.</div>';
                }
                if (titleEl) {
                    titleEl.textContent = 'Item Details';
                }
            });
        }
    </script>
}
